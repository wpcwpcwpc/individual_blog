# 复制为 .env 并填入自己的值；.env 不会进版本库（见 .gitignore）
# 说明：这些变量由 npm 脚本与 astro.config.mjs 读取，凭据绝不写进仓库

# ── 站点 ──────────────────────────────────────────────
# 站点正式地址（影响 canonical、sitemap、OG 分享链接与 robots.txt）
SITE_URL=https://example.com

# 资源路径前缀：根路径部署填 /；子路径部署填 /子目录/
BASE_PATH=/

# ── 部署（Cloudflare Pages）───────────────────────────
# 具有 Pages 编辑权限的 API Token
CLOUDFLARE_API_TOKEN=
# Cloudflare 账户 ID
CLOUDFLARE_ACCOUNT_ID=
# Pages 项目名
CF_PROJECT_NAME=personal-site

# ── PDF 导出（可选）───────────────────────────────────
# 指定 Chromium 可执行文件；不填则自动探测本机 Chrome / Edge
CHROME_PATH=
