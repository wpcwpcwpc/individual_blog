---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { directions, identity, stacks } from '../data/profile';
import { withBase } from '../utils/base';
import { listProjects, listSeriesBundles, listStandalonePosts } from '../utils/content';

const projects = await listProjects();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

// 入口指向"最能说明问题"的那一页：有精选项目就进精选，否则退到第一个项目
const entryProject = featured[0] ?? projects[0];

// 首页是门面不是索引：专栏只出入口卡片，单篇只出最近几篇，全量在 /posts
const series = await listSeriesBundles();
const recentPosts = (await listStandalonePosts()).slice(0, 5);
---

<BaseLayout>
  <section class="hero shell">
    <h1>{SITE.name}</h1>
    <p class="hero__tagline">{identity.headline}</p>
    <div class="hero__intro lede">
      {identity.intro.map((line) => <p>{line}</p>)}
    </div>
    <p class="hero__meta">{identity.experience} · {identity.location}</p>
    <ul class="chips">
      {directions.map((direction) => <li>{direction}</li>)}
    </ul>
    <p class="hero__actions actions">
      <a href={withBase('/resume')}>看简历</a>
      {entryProject && <a href={withBase(`/projects/${entryProject.id}`)}>看项目</a>}
      <a href={`mailto:${SITE.email}`}>邮件联系</a>
    </p>
  </section>

  <section class="section shell">
    <h2>技术栈</h2>
    <dl class="stack">
      {
        stacks.map((group) => (
          <div class="stack__row">
            <dt>{group.name}</dt>
            <dd>
              <ul class="stack__items">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section shell">
    <h2>精选项目</h2>
    {
      featured.length > 0 ? (
        <ul class="cards">
          {featured.map((project) => (
            <li class="card">
              <a href={withBase(`/projects/${project.id}`)}>
                <h3>{project.data.title}</h3>
                <p class="card__tagline">{project.data.tagline}</p>
                <p class="card__summary">{project.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">暂无精选项目。</p>
      )
    }
  </section>

  {
    rest.length > 0 && (
      <section class="section shell">
        <h2>其他项目</h2>
        <ul class="plain">
          {rest.map((project) => (
            <li>
              <a href={withBase(`/projects/${project.id}`)}>{project.data.title}</a>
              <span class="plain__desc">{project.data.tagline}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section shell">
    <h2>文章</h2>
    {
      series.length > 0 && (
        <ul class="cards">
          {series.map((bundle) => (
            <li class="card">
              <a href={withBase('/claudecode')}>
                <h3>{bundle.series.title}</h3>
                <p class="card__tagline">
                  共 {bundle.chapters.length} 章 · {bundle.groups.map((group) => group.name).join(' / ')}
                </p>
                <p class="card__summary">{bundle.series.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      recentPosts.length > 0 ? (
        <ul class="plain">
          {recentPosts.map((post) => (
            <li>
              <a href={withBase(`/posts/${post.id}`)}>{post.data.title}</a>
              <span class="plain__desc">{post.data.summary}</span>
              <time class="plain__date" datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
                {post.data.publishedAt.toISOString().slice(0, 10)}
              </time>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">暂无文章。</p>
      )
    }
    <p class="more">
      <a href={withBase('/posts')}>全部文章 →</a>
    </p>
  </section>

  <section class="section shell" id="contact">
    <h2>联系</h2>
    <ul class="plain contact">
      <li>
        <span class="contact__label">邮箱</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </li>
      <li>
        <span class="contact__label">代码托管</span>
        <a href={SITE.github} rel="me noopener">{SITE.github}</a>
      </li>
      <li>
        <span class="contact__label">简历</span>
        <a href={withBase('/resume')}>文本版</a>
        <span class="plain__desc">·</span>
        <a href={withBase('/resume/pdf')}>PDF 版</a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .shell {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .hero {
    padding-block: var(--space-5) var(--space-4);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(28px, 3.4vw + 14px, 44px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hero__tagline {
    margin: var(--space-3) 0 0;
    max-width: var(--measure);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .hero__meta {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .section {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .section h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    text-transform: none;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow);
  }

  .card a {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .card h3 {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .card__tagline {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .card__summary {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 专栏卡片与单篇列表之间的呼吸感 */
  .cards + .plain {
    margin-top: var(--space-4);
  }

  .more {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xs);
  }

  .plain li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .plain__desc {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .plain__date {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* 联系区：标签定宽，值左对齐成列，长 URL 不与标签挤在一起 */
  .contact__label {
    min-width: 5rem;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .empty {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
</style>
