# ============================================================
# QA Agent System - Environment Configuration (TEMPLATE)
# ============================================================
# Copy this file to `.env` and fill in your own values.
# Every value below is a placeholder — no real credential, host or
# internal endpoint is shipped with this repository.
# ============================================================

# --- LLM Provider (any OpenAI-compatible API) ---
# The shipped default targets the DeepSeek official API. Apply for a key at
# https://platform.deepseek.com and replace the placeholder below.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
# e.g. deepseek-flash (fast, cheap) or deepseek-v4-pro (stronger, 1M context).
LLM_MODEL=deepseek-flash

# --- Embedding (optional — used by the Milvus-backed long-term memory) ---
# NOTE: EMBEDDING_BASE_URL is NOT optional when Milvus memory is enabled. It
# falls back to LLM_BASE_URL, and the chat endpoint above (DeepSeek) exposes no
# /embeddings route — point this at a real embeddings provider instead.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Milvus vector database (optional) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
# "false" runs without Milvus (degraded mode: no long-term memory)
MILVUS_ENABLED=false

# --- Session storage ---
# Options: "mongo" (default) | "sqlite" | "postgres"
STORAGE_BACKEND=mongo
MONGO_URI=mongodb://localhost:27017/
SQLITE_PATH=./data/qa_agent.db
# Required when STORAGE_BACKEND=postgres (the docker-compose default) — there is
# no default, and the storage factory refuses to build a Postgres backend while
# this is empty. When the host is the compose service, keep host "postgres":
#   postgresql://qaagent:<POSTGRES_PASSWORD>@postgres:5432/qa_agent
STORAGE_DSN=postgresql://USER:PASSWORD@localhost:5432/qa_agent

# --- Compose PostgreSQL password (required by docker-compose.yml) ---
# docker-compose.yml ships no password literal, so `docker compose up` fails
# fast unless both POSTGRES_PASSWORD and STORAGE_DSN are set here. Use the same
# password in both.
POSTGRES_PASSWORD=

# --- Session signing key (REQUIRED) ---
# Signs the session cookie set after a successful login callback. There is
# deliberately no default: a predictable key would make sessions forgeable.
# The service refuses to start while this is empty.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- Login provider (OAuth 2.0 / OIDC, authorization code flow) ---
# Point these at any standards-compliant provider; no provider name is baked
# into the code. Leave them empty to run without the login flow — the login
# routes then answer 503 and only pre-authenticated sessions can be used.
# Register the callback URL with your provider:
#   http://<host>:<port>/api/auth/login_callback
# Google example:
#   OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
#   OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
#   OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=openid email profile
# PKCE (S256). Set to false for providers without PKCE support (e.g. GitHub OAuth apps).
OAUTH_PKCE_ENABLED=true

# --- Post-login redirect ---
# Where the browser lands after a successful login. "/" is correct when the UI
# is served by this same process; set an absolute URL when it is not.
FRONTEND_URL=/

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
INTERRUPT_TIMEOUT_MINUTES=30

# --- AgentOS adapter (optional) ---
# AgentOS is Agno's own agent runtime protocol. Prefix the calling platform
# prepends to user_id (e.g. "tenant_"). Leave empty to pass user_id through.
AGENT_OS_USER_ID_PREFIX=

# --- Context thresholds ---
# Fraction of MAX_CONTEXT_TOKENS at which context governance kicks in.
CONTEXT_SOFT_THRESHOLD=0.40
CONTEXT_HARD_THRESHOLD=0.60
MAX_CONTEXT_TOKENS=1000000

# --- Agent defaults ---
DEFAULT_MAX_TURNS=25
NUM_HISTORY_RUNS=5
# "default" | "plan" | "bypass"
DEFAULT_PERMISSION_MODE=default

# --- In-run compression (tool results) ---
COMPRESS_TOOL_RESULTS=true
COMPRESS_TOKEN_LIMIT=500000
COMPRESS_TOOL_RESULTS_TOKEN_LIMIT=100000
COMPRESSION_MODEL_SLOT=slot:default

# --- Skill directories ---
# Project-level skills, relative to the project root.
PROJECT_SKILLS_DIR=.claude/skills
# User-level skills, absolute path.
USER_SKILLS_DIR=~/.qa-agent/skills

# --- MCP ---
# Path to an MCP server config JSON ({"servers": {...}} or Claude Code's
# {"mcpServers": {...}}). Leave empty to run with builtin tools only — no MCP
# servers are discovered, and MCP servers added at runtime live in memory only.
MCP_CONFIG_PATH=

# --- Optional version override ---
# Shown by /health and in the frontend system-status area. Falls back to the
# packaged default when unset.
# APP_VERSION=0.1.0

# --- Model slots (role-based model assignment) ---
# Each slot is a thinking mode. Only override what differs from LLM_MODEL.
# Unconfigured slots fall back to the global default.
# LLM_SLOT_ORCHESTRATE_MODEL=
# LLM_SLOT_ORCHESTRATE_BASE_URL=
# LLM_SLOT_ORCHESTRATE_API_KEY=
# LLM_SLOT_REASON_MODEL=
# LLM_SLOT_VISION_MODEL=
# LLM_SLOT_VISION_BASE_URL=
# LLM_SLOT_VISION_API_KEY=

# --- Models offered in the UI selector ---
# Comma-separated. Falls back to LLM_MODEL when empty.
LLM_AVAILABLE_MODELS=
# Models that accept image input (gates image upload in the UI).
LLM_VISION_MODELS=

# --- Execution safety ---
MAX_BLOCKING_SECONDS=180

# --- Rate limiting (adaptive backoff) ---
RATE_LIMIT_INITIAL_BACKOFF=10
RATE_LIMIT_MAX_BACKOFF=40
RATE_LIMIT_BACKOFF_MULTIPLIER=2
RATE_LIMIT_RECOVERY_THRESHOLD=2
RATE_LIMIT_RECOVERY_DIVISOR=2
